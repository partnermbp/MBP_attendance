{
  "name": "attendance-crm",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:android": "tsc -b && vite build --base=./",
    "android:sync": "npm run build:android && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@capacitor/device": "^8.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "@resvg/resvg-js": "^2.6.2"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.mostbetpartners.attendancecrm",
    "productName": "Attendance CRM",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Attendance CRM.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Attendance CRM"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "attendence_crm.${ext}",
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "Attendance CRM records location automatically when you start and stop a shift."
      }
    }
  }
}
